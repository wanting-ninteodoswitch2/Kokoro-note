<?xml version="1.0" encoding="utf-8"?>
<!--
  以前はこの画面の下部に「端末の全アプリ一覧」をそのまま
  ListView で埋め込んでいたため、上の統計・セットアップ項目に
  スクロール領域を圧迫され、一度に2〜3件しか見えない状態になっていた。

  対象アプリの追加・削除・詳細設定は AppPickerActivity（検索付きの
  専用画面）に分離し、この画面では「いま対象になっているアプリ」だけを
  必要なぶんだけ表示する。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ま。"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textMuted"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <!-- 今日の記録 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <LinearLayout style="@style/StatBox">
                <TextView android:id="@+id/statResisted" style="@style/StatValue" />
                <TextView style="@style/StatLabel" android:text="今日やめた" />
            </LinearLayout>

            <LinearLayout style="@style/StatBox">
                <TextView android:id="@+id/statOpened" style="@style/StatValue" />
                <TextView style="@style/StatLabel" android:text="今日見た" />
            </LinearLayout>

            <LinearLayout style="@style/StatBox">
                <TextView android:id="@+id/statStreak" style="@style/StatValue" />
                <TextView style="@style/StatLabel" android:text="連続日数" />
            </LinearLayout>

        </LinearLayout>

        <!-- 7日間グラフ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="直近7日間"
            android:textColor="@color/textMuted"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <com.uma.maguard.WeeklyChartView
            android:id="@+id/weeklyChart"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/surface"
            android:padding="8dp" />

        <TextView
            android:id="@+id/activeRuleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:paddingTop="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/timeRulesButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="時間帯ルール" />

            <Button
                android:id="@+id/reasonsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="開いた理由" />
        </LinearLayout>

        <!-- セットアップ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/accessibilityButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="1. アプリ検知を許可" />

            <TextView
                android:id="@+id/accessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/overlayButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="2. 重ねて表示を許可" />

            <TextView
                android:id="@+id/overlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/usageStatsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="3. 使用状況へのアクセス" />

            <TextView
                android:id="@+id/usageStatsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/batteryButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="4. 電池最適化を除外" />

            <TextView
                android:id="@+id/batteryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="対象アプリ"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <!-- 対象アプリの一覧はここに実行時に追加される（MainActivity.refreshTargetApps） -->
        <LinearLayout
            android:id="@+id/targetAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyTargetsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="まだ対象アプリがありません。下のボタンから追加してください。"
            android:textColor="@color/textMuted"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/addAppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="＋ アプリを追加" />

    </LinearLayout>
</ScrollView>
