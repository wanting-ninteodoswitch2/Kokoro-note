<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ま。"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setupSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textMuted"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />

            <!-- 今日の記録 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/statResisted" style="@style/StatValue" />
                    <TextView style="@style/StatLabel" android:text="今日やめた" />
                </LinearLayout>

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/statOpened" style="@style/StatValue" />
                    <TextView style="@style/StatLabel" android:text="今日見た" />
                </LinearLayout>

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/statStreak" style="@style/StatValue" />
                    <TextView style="@style/StatLabel" android:text="連続日数" />
                </LinearLayout>

            </LinearLayout>

            <!-- 7日間グラフ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="直近7日間"
                android:textColor="@color/textMuted"
                android:textSize="12sp"
                android:paddingBottom="6dp" />

            <com.uma.maguard.WeeklyChartView
                android:id="@+id/weeklyChart"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@color/surface"
                android:padding="8dp" />

            <TextView
                android:id="@+id/activeRuleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/timeRulesButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="時間帯ルール" />

                <Button
                    android:id="@+id/reasonsButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="開いた理由" />
            </LinearLayout>

            <!-- セットアップ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/accessibilityButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="1. アプリ検知を許可" />

                <TextView
                    android:id="@+id/accessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/overlayButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="2. 重ねて表示を許可" />

                <TextView
                    android:id="@+id/overlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/usageStatsButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="3. 使用状況へのアクセス" />

                <TextView
                    android:id="@+id/usageStatsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/batteryButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="4. 電池最適化を除外" />

                <TextView
                    android:id="@+id/batteryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="対象アプリ（タップでON/OFF）"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <ListView
        android:id="@+id/appListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/surface"
        android:dividerHeight="1dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp" />

</LinearLayout>
