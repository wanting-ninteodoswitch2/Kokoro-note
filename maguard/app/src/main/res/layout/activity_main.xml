<?xml version="1.0" encoding="utf-8"?>
<!--
  対象アプリの追加・削除・詳細設定は AppPickerActivity（検索付きの
  専用画面）に分離し、この画面では「いま対象になっているアプリ」だけを
  必要なぶんだけ表示する。

  カード+アイコン+ステータスピルを基調にしたレイアウト。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ま。"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textMuted"
            android:textSize="13sp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp" />

        <!-- 今日の記録 -->
        <LinearLayout
            style="@style/CardContainer"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/statResisted" style="@style/StatValue" />
                    <TextView style="@style/StatLabel" android:text="今日やめた" />
                </LinearLayout>

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/statOpened" style="@style/StatValue" />
                    <TextView style="@style/StatLabel" android:text="今日見た" />
                </LinearLayout>

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/statStreak" style="@style/StatValue" />
                    <TextView style="@style/StatLabel" android:text="連続日数" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- 7日間グラフ -->
        <LinearLayout
            style="@style/CardContainer"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="直近7日間"
                android:textColor="@color/textMuted"
                android:textSize="12sp"
                android:paddingBottom="10dp" />

            <com.uma.maguard.WeeklyChartView
                android:id="@+id/weeklyChart"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/card_background_flat"
                android:padding="8dp" />

            <TextView
                android:id="@+id/activeRuleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accentText"
                android:textSize="12sp"
                android:paddingTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- クイックアクション -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/timeRulesButton"
                style="@null"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/card_background_flat"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableStart="@drawable/ic_clock"
                android:drawableTint="@color/textMuted"
                android:drawablePadding="8dp"
                android:text="時間帯ルール" />

            <Button
                android:id="@+id/reasonsButton"
                style="@null"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/card_background_flat"
                android:gravity="center"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:drawableStart="@drawable/ic_list"
                android:drawableTint="@color/textMuted"
                android:drawablePadding="8dp"
                android:text="開いた理由" />
        </LinearLayout>

        <!-- セットアップ -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="match_parent"
            android:paddingBottom="10dp"
            android:text="はじめに" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/accessibilityButton"
                    style="@style/SetupRow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_shield"
                    android:text="アプリ検知" />

                <TextView
                    android:id="@+id/accessibilityStatus"
                    style="@style/StatusPill"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/overlayButton"
                    style="@style/SetupRow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_layers"
                    android:text="重ねて表示" />

                <TextView
                    android:id="@+id/overlayStatus"
                    style="@style/StatusPill"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/usageStatsButton"
                    style="@style/SetupRow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_bar_chart"
                    android:text="使用状況へのアクセス" />

                <TextView
                    android:id="@+id/usageStatsStatus"
                    style="@style/StatusPill"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/batteryButton"
                    style="@style/SetupRow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_battery"
                    android:text="電池最適化を除外" />

                <TextView
                    android:id="@+id/batteryStatus"
                    style="@style/StatusPill"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:layout_width="match_parent"
            android:paddingBottom="10dp"
            android:text="対象アプリ" />

        <!-- 対象アプリの一覧はここに実行時に追加される（MainActivity.refreshTargetApps） -->
        <LinearLayout
            android:id="@+id/targetAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyTargetsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="まだ対象アプリがありません。下のボタンから追加してください。"
            android:textColor="@color/textMuted"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/addAppButton"
            style="@null"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_accent_primary"
            android:gravity="center"
            android:textColor="@color/bg"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@color/bg"
            android:drawablePadding="8dp"
            android:text="アプリを追加" />

    </LinearLayout>
</ScrollView>
