<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面「対象アプリ」グリッドの1枚。参考画像（one sec のホーム画面）にある、
  アプリごとに色分けされたカードを模したもの。
  背景色は MainActivity 側でアプリアイコンから抽出した色に差し替える。
  文字は常に白系固定（抽出色は明るすぎないよう補正しているため、
  白文字を前提にできる）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="@drawable/card_background_dynamic"
    android:padding="16dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="7dp"
        android:background="@drawable/icon_badge_circle"
        android:scaleType="centerInside"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/appDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#D9FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
